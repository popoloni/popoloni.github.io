      <data key="k107">Pattern A2</data>
      <data key="k121">{"actual":[],"authors":"","category":"practices","collection":null,"families":["FAMILY:F04"],"id":"OCC:SDD2:A2","kind":"practice_occurrence","label":"Clarify Before Plan","limitation":"Attribution retained as written in the supplied source, not independently verified inventorship.","mapped":[],"printed":false,"streams":[],"summary":"Historical occurrence of Clarify Before Plan in the retained V03 source. The original title, alias and file locator preserve its lineage. Read PAT:067 for the current English operational guidance and its qualifications.","topics":[],"url":"","volumes":["V03"],"year":""}</data>
