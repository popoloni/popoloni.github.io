    <node id="S:4.6">
      <data key="k121">{"actual":["C:C04"],"authors":"","category":"sections","collection":null,"id":"S:4.6","kind":"section","label":"A delta-driven iterative brownfield lifecycle","limitation":"","mapped":["C:C04"],"printed":false,"streams":[],"summary":"Propose short cycles: examine the existing behavior, clarify and version the next intention delta, analyze design impact, implement one reversible slice, independently test, review, deploy and learn. Repository studies motivate the need for bounded changes, while FlowGen compares simulated Scrum/TDD/Waterfall processes on coding benchmarks—not real agile brownfield team outcomes.","topics":[],"url":"","volumes":[],"year":""}</data>
