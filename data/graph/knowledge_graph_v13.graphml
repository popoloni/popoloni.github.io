      <data key="k248">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/06_Figure_3_1_Architect.jpg}
\caption{SE for humans and SE for agents. Conc</data>
      <data key="k263">32</data>
