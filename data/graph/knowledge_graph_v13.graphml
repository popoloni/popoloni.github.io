      <data key="k121">{"actual":["C:C07"],"authors":"","category":"sections","collection":null,"id":"S:7.4","kind":"section","label":"Regression tests for existing and changed behavior","limitation":"","mapped":["C:C07"],"printed":false,"streams":[],"summary":"Derive old/new behavior tests from explicit domain partitions, current production contracts, boundary cases, invalid input and concurrency. Contrast with agent-written tests whose expected values can be biased by buggy code; FlowGen coding-benchmark results are not evidence about real-world brownfield regression-suite effectiveness.","topics":[],"url":"","volumes":[],"year":""}</data>
