      <data key="k513">V06</data>
    </node>
    <node id="V10:TEXTREF:0070">
      <data key="k121">{"actual":[],"authors":"","category":"reader","collection":null,"id":"V10:TEXTREF:0070","kind":"cited_passage","label":"\\includegraphics[width=\\linewidth,height=.62\\textheight,keepaspectratio]{figures/jpg/14_Figure_5_2_Architect.jpg}\n\\caption{Prior AI exposure changes the velocit","limitation":"","mapped":[],"printed":false,"streams":[],"summary":"","topics":[],"url":"","volumes":["V06"],"year":""}</data>
      <data key="k150">VERBATIM_BASELINE</data>
      <data key="k162">CLAIM</data>
      <data key="k246">cited_passage</data>
      <data key="k248">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/14_Figure_5_2_Architect.jpg}
\caption{Prior AI exposure changes the velocit</data>
      <data key="k263">32</data>
      <data key="k265">28</data>
      <data key="k306">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/14_Figure_5_2_Architect.jpg}
\caption{Prior AI exposure changes the velocity signal, not the need for quality gates. Qualitative redraw of W001, original Figure 2; \workref{W001}. The source’s staggered-adoption estimates are grouped here only by direction and cohort. The boxes encode neither effect sizes nor incident rates.}
\label{fig:ch05-research-2}
\end{figure}
</data>
      <data key="k446">4af3b130b9f54d64f83073157f9797b3aeb58f7b0189e020bf8016660d16e7ce</data>
