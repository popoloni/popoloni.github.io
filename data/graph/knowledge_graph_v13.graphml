    <node id="C:C05">
      <data key="k121">{"actual":["C:C05"],"authors":"","category":"chapters","collection":null,"historical_v12_summary":"","id":"C:C05","kind":"chapter","label":"Quality, Architecture and Maintainability","limitation":"","mapped":["C:C05"],"printed":false,"streams":[],"summary":"Separates immediate correctness from architectural fit and maintenance obligations. Through duplication, post-merge evidence and a second change to the running service, it develops fitness checks and explicit stewardship instead of treating a passing test suite as complete quality assurance.","topics":[],"url":"","volumes":[],"year":""}</data>
