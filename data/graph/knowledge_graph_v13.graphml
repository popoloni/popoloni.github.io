      <data key="k162">CLAIM</data>
      <data key="k246">cited_passage</data>
      <data key="k248">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/11_Figure_4_2_Architect.jpg}
\caption{A controlled tool interaction can be </data>
      <data key="k263">34</data>
