      <data key="k121">{"actual":["C:C08"],"authors":"","category":"chapters","collection":null,"historical_v12_summary":"","id":"C:C08","kind":"chapter","label":"Code Review and Trust Calibration","limitation":"","mapped":["C:C08"],"printed":false,"streams":[],"summary":"Allocates review effort by consequence and uncertainty. It examines human and AI reviewers, false positives, shared blind spots and automation bias, then separates finding disposition, coverage of acceptance obligations and the accountable release verdict.","topics":[],"url":"","volumes":[],"year":""}</data>
