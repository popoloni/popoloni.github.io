    <node id="C:C03">
      <data key="k121">{"actual":["C:C03"],"authors":"","category":"chapters","collection":null,"historical_v12_summary":"","id":"C:C03","kind":"chapter","label":"Limits and Capability of Coding Agents","limitation":"","mapped":["C:C03"],"printed":false,"streams":[],"summary":"Turns agent capability into a bounded engineering hypothesis. Permissions, tools, budgets, stopping rules and escalation constrain execution; the chapter compares execution routes and parallel work while keeping technical completion separate from authorized acceptance.","topics":[],"url":"","volumes":[],"year":""}</data>
