      <data key="k121">{"actual":[],"authors":"","category":"practices","collection":null,"families":["FAMILY:F09"],"id":"OCC:NDSE:11","kind":"practice_occurrence","label":"Legacy Code Navigation","limitation":"Attribution retained as written in the supplied source, not independently verified inventorship.","mapped":[],"printed":false,"streams":[],"summary":"Historical occurrence of Legacy Code Navigation in the retained V01 source. The original title, alias and file locator preserve its lineage. Read PAT:053 for the current English operational guidance and its qualifications.","topics":[],"url":"","volumes":["V01"],"year":""}</data>
