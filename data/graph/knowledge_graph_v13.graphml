      <data key="k121">{"actual":["C:C09"],"authors":"","category":"chapters","collection":null,"historical_v12_summary":"","id":"C:C09","kind":"chapter","label":"System Understanding, Context and Persistent Memory","limitation":"","mapped":["C:C09"],"printed":false,"streams":[],"summary":"Treats context and persistent memory as claims with provenance, ownership and expiry. It develops software-specific knowledge records and invalidation rules, then uses a handoff and an explicitly limited retrieval comparison to test what a successor can reconstruct.","topics":[],"url":"","volumes":[],"year":""}</data>
