    <node id="S:1.7">
      <data key="k121">{"actual":["C:C01"],"authors":"","category":"sections","collection":null,"id":"S:1.7","kind":"section","label":"What the research can and cannot tell us","limitation":"","mapped":["C:C01"],"printed":false,"streams":[],"summary":"Explain study types before citing effects: controlled experiments, repository observation, surveys, benchmarks, industrial reports and position papers. Distinguish observed measurements from recommended governance processes, preparing readers to interpret the evidence critically.","topics":[],"url":"","volumes":[],"year":""}</data>
