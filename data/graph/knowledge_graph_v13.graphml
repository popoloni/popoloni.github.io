      <data key="k121">{"actual":[],"authors":"Gergely Orosz; Sandor Felber","category":null,"collection":"P","id":"P049","kind":"practitioner_article","label":"Skills useful to learn for robotics engineering (Robotics for software engineers, Part 3)","limitation":"Guest discloses his robotics startup and hiring interests. Subscriber-only article remainder not reviewed. No microdata replication, controlled product test, or independent-rater agreement study was performed.","mapped":["C:C05","C:C10"],"printed":false,"streams":["T:Skills &amp; learning","T:Engineering structure"],"summary":"Sandor Felber outlines software, AI and robotics skills for work involving real-time control and physical constraints.","topics":["K:Skills formation and teaching","K:Architecture and modularity"],"url":"https://newsletter.pragmaticengineer.com/p/skills-useful-to-learn-for-robotics","volumes":[],"year":"2025-07-08"}</data>
