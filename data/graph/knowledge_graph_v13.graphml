    <node id="V10:TEXTREF:0083">
      <data key="k121">{"actual":[],"authors":"","category":"reader","collection":null,"id":"V10:TEXTREF:0083","kind":"cited_passage","label":"\\includegraphics[width=\\linewidth,height=.62\\textheight,keepaspectratio]{figures/jpg/16_Figure_6_2_Architect.jpg}\n\\caption{Untrusted repository instructions mus","limitation":"","mapped":[],"printed":false,"streams":[],"summary":"","topics":[],"url":"","volumes":["V06"],"year":""}</data>
      <data key="k150">VERBATIM_BASELINE</data>
      <data key="k162">CLAIM</data>
      <data key="k246">cited_passage</data>
      <data key="k248">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/16_Figure_6_2_Architect.jpg}
\caption{Untrusted repository instructions mus</data>
      <data key="k263">33</data>
      <data key="k265">29</data>
      <data key="k306">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/16_Figure_6_2_Architect.jpg}
\caption{Untrusted repository instructions must not become tool authority. Conceptual redraw of W060, original Figure 1; \workref{W060}. Conceptual security-boundary adaptation; this is a recommended control, not the original experiment’s measured defense effectiveness. The runtime must enforce action authority independently of interpreted content.}
\label{fig:ch06-research-2}
\end{figure}
</data>
      <data key="k446">e934e211d633afdf7870484f6b42bef59c9ab46aac83088224b543073328c06c</data>
