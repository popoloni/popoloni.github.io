    <node id="C:C04">
      <data key="k121">{"actual":["C:C04"],"authors":"","category":"chapters","collection":null,"historical_v12_summary":"","id":"C:C04","kind":"chapter","label":"Intentions, Contracts and Iterative Change","limitation":"","mapped":["C:C04"],"printed":false,"streams":[],"summary":"Develops a versioned intention contract for an existing service. Behavioral examples and acceptance rules are established independently of implementation, while late policy changes trigger targeted impact analysis and invalidate only the decisions and evidence they affect.","topics":[],"url":"","volumes":[],"year":""}</data>
