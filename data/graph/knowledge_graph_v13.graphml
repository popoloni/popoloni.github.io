      <data key="k121">{"actual":[],"authors":"","category":"practices","collection":null,"families":["FAMILY:F03"],"id":"OCC:AGENT:04","kind":"practice_occurrence","label":"Initializer-Maintainer Dual Agent Architecture","limitation":"Attribution retained as written in the supplied source, not independently verified inventorship.","mapped":[],"printed":false,"streams":[],"summary":"Historical occurrence of Initializer-Maintainer Dual Agent Architecture in the retained V04 source. The original title, alias and file locator preserve its lineage. Read PAT:004 for the current English operational guidance and its qualifications.","topics":[],"url":"","volumes":["V04"],"year":""}</data>
