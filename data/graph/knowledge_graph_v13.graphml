      <data key="k487">CANONICAL_ID_AND_RECORDED_SCOPE_CHECKED_NOT_NEW_FULL_TEXT_VALIDATION</data>
      <data key="k513">V06</data>
    </node>
    <node id="V10:TEXTREF:0156">
      <data key="k121">{"actual":[],"authors":"","category":"reader","collection":null,"id":"V10:TEXTREF:0156","kind":"cited_passage","label":"\\includegraphics[width=\\linewidth,height=.62\\textheight,keepaspectratio]{figures/jpg/27_Figure_11_2_Architect.jpg}\n\\caption{Policy permission is uneven across c","limitation":"","mapped":[],"printed":false,"streams":[],"summary":"","topics":[],"url":"","volumes":["V06"],"year":""}</data>
      <data key="k150">VERBATIM_BASELINE</data>
      <data key="k162">CLAIM</data>
      <data key="k246">cited_passage</data>
      <data key="k248">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/27_Figure_11_2_Architect.jpg}
\caption{Policy permission is uneven across c</data>
      <data key="k263">37</data>
      <data key="k265">33</data>
      <data key="k306">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/27_Figure_11_2_Architect.jpg}
\caption{Policy permission is uneven across contribution channels. Reported figures of W150, original Figure 2; \workref{W150}. Published percentages from the policy corpus; the bars represent different question codings, not a shared outcome scale. The sampled policies do not recommend leaving channels ungoverned.}
\label{fig:ch11-research-2}
\end{figure}
</data>
      <data key="k446">e627f51f52b6f97852646c0449ab79c2dd450ffb0670b7c496a80c89b32754b0</data>
      <data key="k463">figures/source_redraws/figure_ch11_02.tex</data>
