      <data key="k121">{"actual":[],"authors":"","category":"reader","collection":null,"id":"V10:TEXTREF:0028","kind":"cited_passage","label":"\\includegraphics[width=\\linewidth,height=.62\\textheight,keepaspectratio]{figures/jpg/05_Figure_2_2_Architect.jpg}\n\\caption{Time moves from writing toward agent ","limitation":"","mapped":[],"printed":false,"streams":[],"summary":"","topics":[],"url":"","volumes":["V06"],"year":""}</data>
