      <data key="k121">{"actual":["C:C11"],"authors":"Kief Morris","category":null,"collection":"F","historical_v12_actual":[],"historical_v12_printed":false,"id":"F027","kind":"practitioner_essay","label":"Humans and Agents in Software Engineering Loops","limitation":"A conceptual operating model. Its proposed agentic improvement flywheel is not a demonstrated organizational or reliability result.","mapped":["C:C01","C:C03","C:C11","C:C13"],"printed":true,"streams":["T:Engineering structure","T:Jobs &amp; roles"],"summary":"Distinguishes the why loop that pursues outcomes from nested how loops that build software. Proposes human work on the loop: improving guidance, checks and workflow rather than only editing individual outputs.","topics":["K:Human-agent collaboration","K:Long-running agent execution","K:Specifications and governance"],"url":"https://martinfowler.com/articles/exploring-gen-ai/humans-and-agents.html","volumes":[],"year":"2026-03-04"}</data>
