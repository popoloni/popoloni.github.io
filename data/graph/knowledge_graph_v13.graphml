    <node id="S:11.8">
      <data key="k121">{"actual":["C:C11"],"authors":"","category":"sections","collection":null,"id":"S:11.8","kind":"section","label":"Knowledge handoff and stewardship rights","limitation":"","mapped":["C:C11"],"printed":false,"streams":[],"summary":"Make ownership transfer operational: name current system stewards, define who can modify acceptance contracts, schedule knowledge refresh and attach verified design rationale to handover. This applies the turnover and succession evidence of Chapter 9 to a team policy decision, rather than repeating a literature review of code ownership.","topics":[],"url":"","volumes":[],"year":""}</data>
