    <node id="S:10.2">
      <data key="k121">{"actual":["C:C10"],"authors":"","category":"sections","collection":null,"id":"S:10.2","kind":"section","label":"Comprehension debt is distinct from technical debt","limitation":"","mapped":["C:C10"],"printed":false,"streams":[],"summary":"Define a gap between code shipped and knowledge retained by the team. Ground the term in diary observations from student software projects, and contrast those qualitative patterns with controlled comprehension experiments; do not claim a quantified professional-team effect solely from student self-reports.","topics":[],"url":"","volumes":[],"year":""}</data>
      <data key="k130">2026-10-09 corrected editorial crosswalk</data>
