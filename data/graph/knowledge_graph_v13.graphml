      <data key="k121">{"actual":["C:C04"],"authors":"","category":"sections","collection":null,"id":"S:4.4","kind":"section","label":"Executable contracts without circular oracles","limitation":"","mapped":["C:C04"],"printed":false,"streams":[],"summary":"Map authoritative examples to deterministic assertions, schemas, properties and negative tests. Explain the self-confirmation failure when generated tests copy faulty implementation behavior, and the limited mitigation reported by specification-based prompting. The authoritative acceptance oracle must be reviewed independently from the produced patch.","topics":[],"url":"","volumes":[],"year":""}</data>
