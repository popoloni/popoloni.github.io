    <node id="V10:TEXTREF:0016">
      <data key="k121">{"actual":[],"authors":"","category":"reader","collection":null,"id":"V10:TEXTREF:0016","kind":"cited_passage","label":"\\includegraphics[width=\\linewidth,height=.62\\textheight,keepaspectratio]{figures/jpg/02_Figure_1_2_Architect.jpg}\n\\caption{The software lifecycle extends beyond","limitation":"","mapped":[],"printed":false,"streams":[],"summary":"","topics":[],"url":"","volumes":["V06"],"year":""}</data>
