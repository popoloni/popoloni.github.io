      <data key="k121">{"actual":[],"authors":"","category":"practices","collection":null,"families":["FAMILY:F11"],"id":"OCC:NDSE:14","kind":"practice_occurrence","label":"Parallel Work Orchestration","limitation":"Attribution retained as written in the supplied source, not independently verified inventorship.","mapped":[],"printed":false,"streams":[],"summary":"Historical occurrence of Parallel Work Orchestration in the retained V01 source. The original title, alias and file locator preserve its lineage. Read PAT:056 for the current English operational guidance and its qualifications.","topics":[],"url":"","volumes":["V01"],"year":""}</data>
