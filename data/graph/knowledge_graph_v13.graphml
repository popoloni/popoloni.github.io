    <node id="C:C06">
      <data key="k121">{"actual":["C:C06"],"authors":"","category":"chapters","collection":null,"historical_v12_summary":"","id":"C:C06","kind":"chapter","label":"Securing Generated Code and Agent Runtimes","limitation":"","mapped":["C:C06"],"printed":false,"streams":[],"summary":"Threat-models two distinct surfaces: the generated application and the agent runtime. Dependency provenance, prompt injection, tool permissions and external services become enforceable boundaries, with security evidence tied to the release decision.","topics":[],"url":"","volumes":[],"year":""}</data>
