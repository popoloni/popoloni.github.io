      <data key="k121">{"actual":["C:C04"],"authors":"Birgitta Böckeler","category":null,"collection":"F","historical_v12_actual":[],"historical_v12_printed":false,"id":"F023","kind":"practitioner_essay","label":"Understanding Spec-Driven-Development: Kiro, spec-kit, and Tessl","limitation":"A dated exploratory comparison, not controlled evidence for SDD effectiveness. The author’s questions about specification overhead and source-of-truth claims are retained.","mapped":["C:C04","C:C09","C:C11","C:C13"],"printed":true,"streams":["T:Engineering structure","T:System knowledge &amp; memory"],"summary":"Distinguishes spec-first, spec-anchored and spec-as-source approaches through three tool explorations. Examines persistent specifications, task sizing, brownfield fit, instruction following and documentation overhead.","topics":["K:Specifications and governance","K:Developer workflow and adoption","K:Agent context and persistent memory"],"url":"https://martinfowler.com/articles/exploring-gen-ai/sdd-3-tools.html","volumes":[],"year":"2025-10-15"}</data>
