      <data key="k248">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/22_Figure_9_1_Architect.jpg}
\caption{Episodic and semantic memory answer d</data>
      <data key="k263">32</data>
      <data key="k265">28</data>
      <data key="k306">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/22_Figure_9_1_Architect.jpg}
\caption{Episodic and semantic memory answer different questions. Conceptual redraw of W160, original Figure 2; \workref{W160}. A software-engineering adaptation of AriGraph’s world-model architecture; AriGraph itself was evaluated on text games. Software memory additionally needs contract version and invalidation status.}
\label{fig:ch09-research-1}
\end{figure}
</data>
      <data key="k446">9ac8c5841634ff7bf7aa22128e676eaac2538ef48263998ca4529e1168b02631</data>
