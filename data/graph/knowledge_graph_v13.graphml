      <data key="k107">Regression Safety Net</data>
      <data key="k121">{"actual":[],"authors":"","category":"practices","collection":null,"families":["FAMILY:F07"],"id":"OCC:AGENT:15","kind":"practice_occurrence","label":"Regression Safety Net","limitation":"Attribution retained as written in the supplied source, not independently verified inventorship.","mapped":[],"printed":false,"streams":[],"summary":"Historical occurrence of Regression Safety Net in the retained V04 source. The original title, alias and file locator preserve its lineage. Read PAT:015 for the current English operational guidance and its qualifications.","topics":[],"url":"","volumes":["V04"],"year":""}</data>
      <data key="k162">OCC</data>
      <data key="k212">F07</data>
      <data key="k213">Tests, Oracles and Acceptance Evidence</data>
      <data key="k246">practice_occurrence</data>
      <data key="k248">Regression Safety Net</data>
      <data key="k250">en</data>
      <data key="k260">Attribution retained as written in the supplied source, not independently verified inventorship.</data>
      <data key="k292">["\\textbf{Ralph connection:} Huntley addresses this in his CURSED prompt: ``If tests unrelated to your work fail then it's your job to resolve these tests as part of the increment of change.'' The Regression Safety Net pattern formalizes this into a rule: agents must leave the test suite in the same or better state than they found it. No new test failures allowed, period."]</data>
      <data key="k373">PAT:015</data>
      <data key="k460">296</data>
      <data key="k463">ai-auto_eng/AI_AUTO_ENG/chapters/chapter09_patterns.tex</data>
      <data key="k467">289</data>
      <data key="k477">3c88f9e5d7b0288e46de69503668ac80ecb7778165d80bf74eab10da30c4e2ba</data>
      <data key="k487">HISTORICAL_SOURCE_OCCURRENCE</data>
      <data key="k513">V04</data>
    </node>
