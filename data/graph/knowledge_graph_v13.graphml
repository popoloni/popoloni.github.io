    <node id="S:1.8">
      <data key="k121">{"actual":["C:C01"],"authors":"","category":"sections","collection":null,"id":"S:1.8","kind":"section","label":"A teaching case, not a reported field experiment","limitation":"","mapped":["C:C01"],"printed":false,"streams":[],"summary":"Introduce the invented transaction-approval API, its legacy interfaces, ambiguous regional threshold request and audit obligations. Make the system boundary and synthetic data explicit. Ownership and review findings explain why the example is realistic; no cited paper is claimed to have studied this particular service.","topics":[],"url":"","volumes":[],"year":""}</data>
