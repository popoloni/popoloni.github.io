    <node id="V10:TEXTREF:0141">
      <data key="k121">{"actual":[],"authors":"","category":"reader","collection":null,"id":"V10:TEXTREF:0141","kind":"cited_passage","label":"\\includegraphics[width=\\linewidth,height=.62\\textheight,keepaspectratio]{figures/jpg/25_Figure_10_2_Architect.jpg}\n\\caption{Task completion and immediate compre","limitation":"","mapped":[],"printed":false,"streams":[],"summary":"","topics":[],"url":"","volumes":["V06"],"year":""}</data>
      <data key="k150">VERBATIM_BASELINE</data>
      <data key="k162">CLAIM</data>
      <data key="k246">cited_passage</data>
      <data key="k248">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/25_Figure_10_2_Architect.jpg}
\caption{Task completion and immediate compre</data>
      <data key="k263">30</data>
      <data key="k265">26</data>
      <data key="k306">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/25_Figure_10_2_Architect.jpg}
\caption{Task completion and immediate comprehension are separate outcomes. Qualitative redraw of W118, original Figure 1; \workref{W118}. The source reports lower immediate quiz scores with AI assistance; its percentage normalization is unresolved (Appendix~\ref{app:methodology}, \S\ref{app:commentary-ch10}). Usage-pattern comparisons are exploratory, and delayed retention was not measured.}
\label{fig:ch10-research-2}
\end{figure}
</data>
      <data key="k446">36c6f8ee913ac6d8776162bbe659370c1dac6f0f0d0cf9f7b8ea335242b78e27</data>
