      <data key="k121">{"actual":["C:C07"],"authors":"","category":"sections","collection":null,"id":"S:7.8","kind":"section","label":"Bounded repair versus independent acceptance","limitation":"","mapped":["C:C07"],"printed":false,"streams":[],"summary":"Specify a bounded loop of diagnose, attempt, retest and evidence collection, followed by an external checker and human owner. A local pass is only review-ready; repeated rejection without a cited policy or changed evidence triggers adjudication instead of unbounded reruns. The exact budget and escalation policy is an author-proposed mechanism to pilot.","topics":[],"url":"","volumes":[],"year":""}</data>
