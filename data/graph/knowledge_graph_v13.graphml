      <data key="k107">Trust Calibration</data>
      <data key="k121">{"actual":[],"authors":"","category":"practices","collection":null,"families":["FAMILY:F08"],"id":"OCC:AGENT:22","kind":"practice_occurrence","label":"Trust Calibration","limitation":"Attribution retained as written in the supplied source, not independently verified inventorship.","mapped":[],"printed":false,"streams":[],"summary":"Historical occurrence of Trust Calibration in the retained V04 source. The original title, alias and file locator preserve its lineage. Read PAT:022 for the current English operational guidance and its qualifications.","topics":[],"url":"","volumes":["V04"],"year":""}</data>
