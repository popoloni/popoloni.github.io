      <data key="k121">{"actual":[],"authors":"Giles Edwards-Alexander","category":null,"collection":"F","historical_v12_printed":false,"id":"F030","kind":"practitioner_essay","label":"The Economic Benefit of Refactoring","limitation":"One application and change, approximate token counting and incomplete refactoring-cost accounting; this does not establish general ROI or savings for every future task.","mapped":["C:C02","C:C05","C:C12"],"printed":true,"streams":["T:Economics","T:Code quality &amp; security"],"summary":"Repeats one representative change as a large Rust data-access module is refactored. Estimated input-token use falls after decomposition permits more selective code reading, connecting architecture to inference work.","topics":["K:Economic costs and return","K:Architecture and modularity","K:Code reuse and duplication"],"url":"https://martinfowler.com/articles/exploring-gen-ai/refactoring-economic-benefit.html","volumes":[],"year":"2026-07-30"}</data>
