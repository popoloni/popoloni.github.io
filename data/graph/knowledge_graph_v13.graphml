    <node id="OCC:AGENT:11">
      <data key="k107">Reward Shaping for Tool Use</data>
      <data key="k121">{"actual":[],"authors":"","category":"practices","collection":null,"families":["FAMILY:F03"],"id":"OCC:AGENT:11","kind":"practice_occurrence","label":"Reward Shaping for Tool Use","limitation":"Attribution retained as written in the supplied source, not independently verified inventorship.","mapped":[],"printed":false,"streams":[],"summary":"Historical occurrence of Reward Shaping for Tool Use in the retained V04 source. The original title, alias and file locator preserve its lineage. Read PAT:011 for the current English operational guidance and its qualifications.","topics":[],"url":"","volumes":["V04"],"year":""}</data>
