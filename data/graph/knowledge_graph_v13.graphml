    <node id="V10:TEXTREF:0126">
      <data key="k121">{"actual":[],"authors":"","category":"reader","collection":null,"id":"V10:TEXTREF:0126","kind":"cited_passage","label":"\\includegraphics[width=\\linewidth,height=.62\\textheight,keepaspectratio]{figures/jpg/23_Figure_9_2_Architect.jpg}\n\\caption{Memory must survive compaction and re","limitation":"","mapped":[],"printed":false,"streams":[],"summary":"","topics":[],"url":"","volumes":["V06"],"year":""}</data>
      <data key="k150">VERBATIM_BASELINE</data>
      <data key="k162">CLAIM</data>
      <data key="k246">cited_passage</data>
      <data key="k248">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/23_Figure_9_2_Architect.jpg}
\caption{Memory must survive compaction and re</data>
      <data key="k263">32</data>
      <data key="k265">28</data>
      <data key="k306">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/23_Figure_9_2_Architect.jpg}
\caption{Memory must survive compaction and reset by harness policy. Conceptual redraw of W157, original Figure 1; \workref{W157}. Compresses the paper’s typed pages, compaction boundary and validated journal; no performance claims. State integrity is a harness obligation, not a prompt request.}
\label{fig:ch09-research-2}
\end{figure}
</data>
      <data key="k446">b39e6cd968ede8b60da7aa258349c2e9528c3d9b94b94d6b8dd006e3a14f5daf</data>
