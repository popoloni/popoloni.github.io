    <node id="OCC:SDD2:D2">
      <data key="k107">Pattern D2</data>
      <data key="k121">{"actual":[],"authors":"","category":"practices","collection":null,"families":["FAMILY:F07"],"id":"OCC:SDD2:D2","kind":"practice_occurrence","label":"Evidence-Pack Provenance","limitation":"Attribution retained as written in the supplied source, not independently verified inventorship.","mapped":[],"printed":false,"streams":[],"summary":"Historical occurrence of Evidence-Pack Provenance in the retained V03 source. The original title, alias and file locator preserve its lineage. Read PAT:082 for the current English operational guidance and its qualifications.","topics":[],"url":"","volumes":["V03"],"year":""}</data>
      <data key="k162">OCC</data>
      <data key="k212">F07</data>
      <data key="k213">Tests, Oracles and Acceptance Evidence</data>
      <data key="k246">practice_occurrence</data>
      <data key="k248">Evidence-Pack Provenance</data>
      <data key="k250">en</data>
      <data key="k260">Attribution retained as written in the supplied source, not independently verified inventorship.</data>
      <data key="k292">["%  Sources: Ralph Copilot's per-cycle documentation model.]", "\\paragraph{Solution.} Every autonomous cycle produces a structured \\textbf{evidence pack}\\,---\\,three artifacts at minimum, written to a per-cycle directory under \\code{.specify/evidence/}. The \\code{prompt.md} captures the exact input the agent received: the spec excerpt, the constitution sections, the prior artifacts, the task statement. The \\code{result.md} captures what the agent did: the diff, the test results, the tools invoked, the decisions made and their rationale. The \\code{verdict.md} captures the agent's self-assessment: did the cycle meet the acceptance criteria? Which evidence supports that claim? Which open questions remain? The pack is committed to the repository (it is part of the source of truth, not a transient log) and is linked from \\code{tasks.md} so the trail from item to cycle to evidence is one click."]</data>
      <data key="k373">PAT:082</data>
      <data key="k460">642</data>
      <data key="k463">AI_SDD_ENG_V2/chapters/chapter15_patterns.tex</data>
      <data key="k467">607</data>
      <data key="k477">4830546709bc5f2eb4641c47add3bb9992eb9089497514ac25f321b33f5f92aa</data>
