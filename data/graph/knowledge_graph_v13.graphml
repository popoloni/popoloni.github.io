    <node id="C:C07">
      <data key="k121">{"actual":["C:C07"],"authors":"","category":"chapters","collection":null,"historical_v12_summary":"","id":"C:C07","kind":"chapter","label":"Independent Verification and the Oracle Problem","limitation":"","mapped":["C:C07"],"printed":false,"streams":[],"summary":"Builds independent verification around authorized behavior. Regression cases, properties, counterexamples and mutants expose circular testing; correlated checker errors and benchmark limits motivate an evidence dossier that supports review without granting the maker acceptance authority.","topics":[],"url":"","volumes":[],"year":""}</data>
