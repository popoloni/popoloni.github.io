    <node id="S:4.8">
      <data key="k121">{"actual":["C:C04"],"authors":"","category":"sections","collection":null,"id":"S:4.8","kind":"section","label":"Native intent gates and optional compatibility adapters","limitation":"","mapped":["C:C04"],"printed":false,"streams":[],"summary":"Define native gates on approved intention, invariants, architecture decisions, verification evidence and acceptance authority. Keep a legacy user-story/test-case view as an optional adapter when integrating established CI, rather than treating it as canonical. Use the CCS profile as a worked engineering example, not a method empirically demonstrated by Farrag or Qiu.","topics":[],"url":"","volumes":[],"year":""}</data>
