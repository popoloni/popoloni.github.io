      <data key="k121">{"actual":["C:C01"],"authors":"","category":"sections","collection":null,"id":"S:1.6","kind":"section","label":"Why brownfield change starts with system comprehension","limitation":"","mapped":["C:C01"],"printed":false,"streams":[],"summary":"Introduce the existing system's implicit invariants, distributed rationale and human ownership as prerequisites to a safe code edit. An early minimum context package must exist before Chapter 3 lets an agent inspect the repository; Chapter 9 will later explain how to preserve and update that knowledge durably.","topics":[],"url":"","volumes":[],"year":""}</data>
