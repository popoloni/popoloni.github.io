    <node id="DOC:V10:appendices/work_id_index.tex">
      <data key="k121">{"actual":[],"authors":"","category":"reader","collection":null,"id":"DOC:V10:appendices/work_id_index.tex","kind":"current_reader_file","label":"appendices/work_id_index.tex","limitation":"","mapped":[],"printed":false,"streams":[],"summary":"","topics":[],"url":"","volumes":["V06"],"year":""}</data>
