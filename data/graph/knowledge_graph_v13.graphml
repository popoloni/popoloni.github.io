\label{fig:ch05-research-1}
\end{figure}
</data>
      <data key="k446">3134a4a60189ff981e0a0d20b7c8bdd209923eae03fe17f751af28d8c1eafa4b</data>
      <data key="k463">figures/source_redraws/figure_ch05_01.tex</data>
