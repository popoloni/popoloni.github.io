\label{fig:ch11-research-1}
\end{figure}
</data>
      <data key="k446">fd584bd6b87c0f9c53d39a08adfdd233d9431265b516e7b2a7a09c71748201b0</data>
      <data key="k463">figures/source_redraws/figure_ch11_01.tex</data>
