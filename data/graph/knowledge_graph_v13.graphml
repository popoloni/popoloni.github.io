      <data key="k121">{"actual":[],"authors":"Gergely Orosz; Quentin Pradet","category":null,"collection":"P","id":"P053","kind":"practitioner_article","label":"Building great SDKs","limitation":"A section explicitly discusses LLM-assisted SDK generation; it is secondary to the broader SDK design guidance. Subscriber-only article remainder not reviewed. No microdata replication, controlled product test, or independent-rater agreement study was performed.","mapped":["C:C04","C:C05"],"printed":false,"streams":["T:Code quality &amp; security","T:Engineering structure"],"summary":"Quentin Pradet examines API-first design, SDK generation, documentation and ongoing maintenance for human and model consumers.","topics":["K:Architecture and modularity","K:Code reuse and duplication","K:Specifications and governance"],"url":"https://newsletter.pragmaticengineer.com/p/building-great-sdks","volumes":[],"year":"2025-07-29"}</data>
