  <data key="d489">Antipatterns: What Not to Do (L5)</data>
  <data key="d490">Frozen v6 node W065 summary/contribution and limitation</data>
  <data key="d491">Recorded GitHub review is not total review rigor; shared AIDev data.</data>
  <data key="d492">NO</data>
  <data key="d493">NO</data>
  <data key="d458">EDITORIAL_ARGUMENTED_UNSCORED</data>
</edge>
