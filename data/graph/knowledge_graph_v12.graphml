\caption{Independent labels matter when checkers share errors. Reported figures of W079, original Figure 1 (Helm panel); \workref{W079}. Average conditional agreement $0.60$ versus uniform-choice baseline $1/3$ for the Helm setup; bars replace the original model-pair heatmap. This is not a universal coding-agent error rate; another model is not an independent oracle by default.}
\label{fig:ch07-research-1}
\end{figure}
</data>
  <data key="d259">918ca878f8a5dbc42a60038881ff0baf9498dd5a927f03737021a04c5362faf1</data>
  <data key="d183">CANONICAL_ID_AND_RECORDED_SCOPE_CHECKED_NOT_NEW_FULL_TEXT_VALIDATION</data>
  <data key="d390">["W079"]</data>
  <data key="d391">VERBATIM_BASELINE</data>
</node>
<node id="V10:TEXTREF:0098">
  <data key="d73">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/18_Figure_7_2_Architect.jpg}
\caption{Reliability grows through an evidence</data>
  <data key="d74">cited_passage</data>
  <data key="d357">CLAIM</data>
  <data key="d358">V06</data>
  <data key="d355">figures/source_redraws/figure_ch07_02.tex</data>
