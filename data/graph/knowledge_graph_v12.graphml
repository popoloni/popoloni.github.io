<node id="V10:TEXTREF:0141">
  <data key="d73">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/25_Figure_10_2_Architect.jpg}
\caption{Task completion and immediate compre</data>
  <data key="d74">cited_passage</data>
  <data key="d357">CLAIM</data>
  <data key="d358">V06</data>
  <data key="d355">figures/source_redraws/figure_ch10_02.tex</data>
