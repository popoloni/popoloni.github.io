\end{figure}
</data>
  <data key="d259">3134a4a60189ff981e0a0d20b7c8bdd209923eae03fe17f751af28d8c1eafa4b</data>
  <data key="d183">CANONICAL_ID_AND_RECORDED_SCOPE_CHECKED_NOT_NEW_FULL_TEXT_VALIDATION</data>
  <data key="d390">["W054"]</data>
  <data key="d391">VERBATIM_BASELINE</data>
</node>
<node id="V10:TEXTREF:0070">
  <data key="d73">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/14_Figure_5_2_Architect.jpg}
\caption{Prior AI exposure changes the velocit</data>
  <data key="d74">cited_passage</data>
  <data key="d357">CLAIM</data>
  <data key="d358">V06</data>
  <data key="d355">figures/source_redraws/figure_ch05_02.tex</data>
