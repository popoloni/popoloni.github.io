  <data key="d73">What is Growth Engineering?</data>
  <data key="d74">practitioner_article</data>
  <data key="d96">CURATED_PRACTITIONER_NOT_PEER_REVIEWED_RESEARCH</data>
  <data key="d75">Engineering structure</data>
