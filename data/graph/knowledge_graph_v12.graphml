<node id="O033">
  <data key="d73">The "Trust, But Verify" Pattern For AI-Assisted Engineering</data>
  <data key="d74">practitioner_article</data>
  <data key="d96">CURATED_PRACTITIONER_NOT_RESEARCH</data>
  <data key="d75">Verification &amp; review</data>
  <data key="d76">2025</data>
  <data key="d77">Addy Osmani</data>
  <data key="d78">https://addyo.substack.com/p/the-trust-but-verify-pattern-for</data>
