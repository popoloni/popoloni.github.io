  <data key="d73">Plan-Then-Execute</data>
  <data key="d74">practice_descriptor</data>
  <data key="d357">PAT</data>
  <data key="d378">F03</data>
  <data key="d377">3</data>
  <data key="d380">RICOMPORRE</data>
  <data key="d381">Piano sostituibile, intenzione modificabile solo con delta autorizzato.</data>
  <data key="d382">["AGENT:01"]</data>
  <data key="d183">RECONCILED_EDITORIAL_DESCRIPTOR</data>
  <data key="d80">A pattern descriptor is not evidence of effectiveness. Specialized variants may remain companion-only.</data>
</node>
<node id="PAT:002">
