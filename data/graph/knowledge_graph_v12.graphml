  <data key="d73">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/23_Figure_9_2_Architect.jpg}
\caption{Memory must survive compaction and re</data>
  <data key="d74">cited_passage</data>
  <data key="d357">CLAIM</data>
  <data key="d358">V06</data>
  <data key="d355">figures/source_redraws/figure_ch09_02.tex</data>
