  <data key="d74">practice_occurrence</data>
  <data key="d357">OCC</data>
  <data key="d358">V04</data>
  <data key="d378">F03</data>
  <data key="d383">Initializer-Maintainer Dual Agent Architecture</data>
  <data key="d355">ai-auto_eng/AI_AUTO_ENG/chapters/chapter09_patterns.tex</data>
  <data key="d384">137</data>
  <data key="d385">144</data>
  <data key="d356">3c88f9e5d7b0288e46de69503668ac80ecb7778165d80bf74eab10da30c4e2ba</data>
  <data key="d386">["\\textbf{Ralph connection:} This maps to Huntley's observation that Ralph ``works best as a technique for bootstrapping Greenfield, with the expectation you'll get 90\\% done with it.'' The dual-agent pattern formalizes the transition point: when do you switch from aggressive generation to careful maintenance? The answer is usually when your test suite is robust enough to serve as backpressure."]</data>
