<node id="OCC:AGENT:08">
  <data key="d73">Agent-Powered Codebase Q&amp;A and Onboarding</data>
  <data key="d74">practice_occurrence</data>
  <data key="d357">OCC</data>
  <data key="d358">V04</data>
  <data key="d378">F09</data>
  <data key="d383">Agent-Powered Codebase Q\&amp;A and Onboarding</data>
  <data key="d355">ai-auto_eng/AI_AUTO_ENG/chapters/chapter09_patterns.tex</data>
  <data key="d384">197</data>
  <data key="d385">211</data>
  <data key="d356">3c88f9e5d7b0288e46de69503668ac80ecb7778165d80bf74eab10da30c4e2ba</data>
  <data key="d386">["\\textbf{Ralph connection:} This pattern suggests a dedicated orientation phase at the start of each Ralph iteration. Rather than just reading \\texttt{AGENTS.md}, the agent can actively search and query the codebase to build understanding. Huntley's ``search before implementing'' instruction is a minimal version of this; the full pattern extends it to systematic codebase comprehension."]</data>
  <data key="d183">HISTORICAL_SOURCE_OCCURRENCE</data>
  <data key="d80">Attribution retained as written in the supplied source, not independently verified inventorship.</data>
