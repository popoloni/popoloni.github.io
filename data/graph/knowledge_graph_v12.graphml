<node id="OCC:AGENT:15">
  <data key="d73">Regression Safety Net</data>
  <data key="d74">practice_occurrence</data>
  <data key="d357">OCC</data>
  <data key="d358">V04</data>
  <data key="d378">F07</data>
  <data key="d383">Regression Safety Net</data>
  <data key="d355">ai-auto_eng/AI_AUTO_ENG/chapters/chapter09_patterns.tex</data>
  <data key="d384">289</data>
  <data key="d385">296</data>
  <data key="d356">3c88f9e5d7b0288e46de69503668ac80ecb7778165d80bf74eab10da30c4e2ba</data>
  <data key="d386">["\\textbf{Ralph connection:} Huntley addresses this in his CURSED prompt: ``If tests unrelated to your work fail then it's your job to resolve these tests as part of the increment of change.'' The Regression Safety Net pattern formalizes this into a rule: agents must leave the test suite in the same or better state than they found it. No new test failures allowed, period."]</data>
  <data key="d183">HISTORICAL_SOURCE_OCCURRENCE</data>
  <data key="d80">Attribution retained as written in the supplied source, not independently verified inventorship.</data>
</node>
