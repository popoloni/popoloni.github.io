  <data key="d428">AI_SDD_ENG_V2/appendices/reference_cards/appendix_aidd.tex</data>
  <data key="d483">4</data>
  <data key="d467">EDITORIAL_NOT_EMPIRICAL_VALIDATION</data>
  <data key="d488">architecture</data>
  <data key="d489">AIDD (L4)</data>
  <data key="d490">Frozen v6 node P066 summary/contribution and limitation</data>
  <data key="d491"> Subscriber-only article remainder not reviewed. No microdata replication, controlled product test, or independent-rater agreement study was performed.</data>
  <data key="d492">NO</data>
  <data key="d493">NO</data>
  <data key="d458">EDITORIAL_ARGUMENTED_UNSCORED</data>
</edge>
