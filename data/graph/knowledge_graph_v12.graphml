  <data key="d370">["T:Engineering structure", "T:Verification &amp; review", "T:Productivity", "T:Skills &amp; learning"]</data>
  <data key="d371">["K:Specifications and governance", "K:Independent verification and oracles", "K:Developer workflow and adoption", "K:Evaluation methodology and baselines"]</data>
  <data key="d372">["C:C01", "C:C04"]</data>
