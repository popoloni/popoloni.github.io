<node id="V10:TEXTREF:0083">
  <data key="d73">\includegraphics[width=\linewidth,height=.62\textheight,keepaspectratio]{figures/jpg/16_Figure_6_2_Architect.jpg}
\caption{Untrusted repository instructions mus</data>
  <data key="d74">cited_passage</data>
