  <data key="d78">https://newsletter.pragmaticengineer.com/p/what-is-growth-engineering</data>
  <data key="d168">https://newsletter.pragmaticengineer.com/p/what-is-growth-engineering</data>
  <data key="d226">https://newsletter.pragmaticengineer.com/p/what-is-growth-engineering</data>
  <data key="d173">2025-03-20</data>
  <data key="d294">Canonical article edition date; earlier identified parent-issue date retained separately</data>
  <data key="d295">2025-03-20</data>
