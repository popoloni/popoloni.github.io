<node id="P109">
  <data key="d73">Tech jobs market in 2026, part 3: hiring managers &amp; job seekers</data>
  <data key="d74">practitioner_article</data>
  <data key="d96">CURATED_PRACTITIONER_NOT_PEER_REVIEWED_RESEARCH</data>
  <data key="d75">Jobs &amp; roles</data>
  <data key="d76">2026</data>
