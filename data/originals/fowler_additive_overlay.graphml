<node id="F010">
  <data key="d2">Building an AI agent application to migrate a tech stack</data>
  <data key="d3">practitioner_essay</data>
  <data key="d4">F</data>
  <data key="d5">Birgitta Böckeler</data>
  <data key="d6">["Birgitta Böckeler"]</data>
  <data key="d7">2024-08-20</data>
  <data key="d8">Dated entry on the supplied series index; article date also used where printed</data>
